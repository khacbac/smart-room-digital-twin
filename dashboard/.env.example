# Copy to .env.local. NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_DEVICE_CODE=room-01
# backend = REST + SSE from our Node backend (works today)
# firestore = placeholder for the cloud team (src/lib/datasource/firestore.ts)
NEXT_PUBLIC_DATA_SOURCE=backend
