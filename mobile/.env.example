# Defaults for a fresh install; both can be changed in the app (Settings) and are kept on the phone.
# Leave the URL unset in dev: the app uses the machine Metro runs on (port 4000), which works on the emulator
# and on a phone on the same Wi-Fi as long as the server listens on HOST=0.0.0.0 (server/.env).
# Set it only to point at another backend (or for a release build).
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:4000
EXPO_PUBLIC_DEVICE_CODE=room-01
