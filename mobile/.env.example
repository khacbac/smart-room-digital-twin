# Defaults for a fresh install; both can be changed in the app (Settings) and are kept on the phone.
# Android emulator → host machine is 10.0.2.2. On a real phone use the computer's LAN IP
# (and HOST=0.0.0.0 in server/.env), or 127.0.0.1 with `adb reverse tcp:4000 tcp:4000`.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000
EXPO_PUBLIC_DEVICE_CODE=room-01
