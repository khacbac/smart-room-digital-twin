rules_version = '2';

// Deny-all, on purpose.
//
// Every read and write goes through the backend: the dashboard gets its data from
// `GET /api/devices/:code` and the SSE stream, and commands are published to MQTT by the
// backend, which is the only publisher. No browser ever talks to Firestore directly, so
// no client needs access here. The backend uses the Admin SDK, which bypasses these rules.
//
// Relax this only when the dashboard starts reading Firestore directly (docs/cloud.md §5),
// and then only together with Firebase Auth (§6).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
