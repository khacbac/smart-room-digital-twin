PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3100   # comma-separated; add the Firebase Hosting origin when deployed
LOG_LEVEL=info

MQTT_URL=mqtt://127.0.0.1:1883   # not "localhost": it can resolve to ::1 on Windows, and Mosquitto listens on 127.0.0.1 only
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=srdt           # must match MQTT_TOPIC_PREFIX in device/include/config.h

# Storage (docs/cloud.md). memory = in RAM, lost on restart. firestore = Cloud Firestore.
STORAGE_DRIVER=memory
GCP_PROJECT_ID=                  # required when STORAGE_DRIVER=firestore
FIRESTORE_DATABASE_ID=           # empty = the project's "(default)" database
# Service-account key for the Admin SDK. Relative paths resolve against server/, which is
# the cwd of `pnpm dev:server`. Read by firebase-admin itself, not by the zod config.
GOOGLE_APPLICATION_CREDENTIALS=  # ../cloud/firebase/service-account.json

SEED_DEVICES=room-01
AUTO_REGISTER_DEVICES=true
TELEMETRY_PERSIST_INTERVAL_SEC=5   # use 15 with STORAGE_DRIVER=firestore to stay inside the free write quota
DEVICE_OFFLINE_AFTER_SEC=45
DEVICE_PERSIST_INTERVAL_SEC=60   # device doc write throttle; SSE is unaffected
COMMAND_ACK_TIMEOUT_SEC=10
SNAPSHOT_TELEMETRY_MIN=15
