PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3100   # comma-separated; add the Firebase Hosting origin when deployed
LOG_LEVEL=info

MQTT_URL=mqtt://127.0.0.1:1883   # not "localhost": it can resolve to ::1 on Windows, and Mosquitto listens on 127.0.0.1 only
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=srdt           # must match MQTT_TOPIC_PREFIX in device/include/config.h

# Storage (docs/cloud.md). memory = works today, lost on restart.
# firestore = stub for the cloud team (every call throws until it is implemented).
STORAGE_DRIVER=memory
GCP_PROJECT_ID=

SEED_DEVICES=room-01
AUTO_REGISTER_DEVICES=true
TELEMETRY_PERSIST_INTERVAL_SEC=5
DEVICE_OFFLINE_AFTER_SEC=45
COMMAND_ACK_TIMEOUT_SEC=10
SNAPSHOT_TELEMETRY_MIN=15
