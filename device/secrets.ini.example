; Real-board config for env:gateway (M3, docs/link-protocol.md §6.1). Copy to
; secrets.ini (gitignored) and fill in; platformio.ini loads it if it exists.
; Without it, env:gateway builds with the Wokwi defaults in include/config.h
; (Wokwi-GUEST, host.wokwi.internal), which never connect on a real board.
;
; MQTT_HOST: the LAN IP of the PC running Mosquitto with broker/mosquitto-lan.conf
; (ipconfig → IPv4 Address), on the same Wi-Fi as the gateway.
; WIFI_CHANNEL=0 scans; config.h pins channel 6 for Wokwi-GUEST.
; Wi-Fi must be 2.4 GHz: the ESP32-S3 has no 5 GHz radio.
; Board v1.1: add -D PIN_STATUS_RGB=38 (§5.5).

[env:gateway]
build_flags =
    ${env.build_flags}
    '-D WIFI_SSID="my-wifi"'
    '-D WIFI_PASSWORD="my-password"'
    -D WIFI_CHANNEL=0
    '-D MQTT_HOST="192.168.1.10"'
